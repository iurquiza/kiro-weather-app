{
  "enabled": true,
  "name": "Git Add and Commit Updates",
  "description": "After each agent session, stages all changed files and commits them to the current git branch.",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "runCommand",
    "command": "git add -A && git commit -m \"Auto-commit: save file updates\""
  }
}